# Copy to .env and fill in. Never commit .env — only this file.
#
#   cp .env.example .env

# --- OpenRouter -------------------------------------------------------------
# The key we sent you. Same key for your coding assistant and for the models
# inside your solution. Hard cap of $10.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Models -----------------------------------------------------------------
# Model names belong here, not in your code — we will swap them when we run it.
# Any model on OpenRouter is fair game; pick ones that handle French well.
# (Coding assistant model lives in opencode.json: qwen/qwen3-coder.)

# Primary agent. Strong French, native tool calling, Flash-tier price (~$0.30/$2.50 per M).
CHAT_MODEL=google/gemini-2.5-flash

# Fallback on 429/529 via OpenRouter "models" routing. Different provider (Mistral,
# French-native training), cheap, tool calling supported.
CHAT_MODEL_FALLBACK=mistralai/mistral-small-3.2-24b-instruct

# Eval judge. Deliberately a different family from CHAT_MODEL to limit self-preference bias.
JUDGE_MODEL=openai/gpt-4.1-mini

# Retrieval embeddings. #1 on MTEB-Multilingual (70.6, Qwen3-Embedding paper 2025), strong
# French, supports a query-side task instruction (bridges colloquial customer French vs
# formal doc French), open weights, $0.01/M. Baseline for comparison: openai/text-embedding-3-small.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# One-off transcription of corpus/fiche-roaming-international-scan.png (cached in .cache/ocr).
VISION_MODEL=google/gemini-2.5-flash

# --- Simulation clock -------------------------------------------------------
# The dataset is frozen around 25 Aug 2026 (incidents, slots, invoices). Keep set for
# reproducible demos/evals; unset to use the real wall clock.
REFERENCE_NOW=2026-08-25T10:00:00+02:00

# --- Your FastAPI service ---------------------------------------------------
API_BASE_URL=http://localhost:8000
# Probability [0..1] of injecting HTTP 500 on any API call (failure-handling demos/evals).
API_CHAOS_RATE=0.0

# --- Guardrails -------------------------------------------------------------
# 1 = run the LLM groundedness check on every answer (extra call per turn).
GROUNDING_CHECK=0

# --- Langfuse (bonus, optional) ---------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
